# ==============================================================================
# InsightPath Backend Production Environment Configuration
# ==============================================================================

# Server Network Binding
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Application Metadata
PROJECT_NAME="InsightPath Career Intelligence API"
VERSION=1.0.0
API_V1_STR=/api/v1

# Cross-Origin Resource Sharing (CORS)
# Set to comma-separated URLs or wildcard '*'
# Example: https://insightpath.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:3000

# Optional Path & Storage Overrides (Leave empty for dynamic resolution)
# PROJECT_ROOT=/app
# TABLES_DIR=outputs/tables
# MODELS_DIR=outputs/models

# Optional Supabase Integration (Server-side only if enabled)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
