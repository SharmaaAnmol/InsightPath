# ==============================================================================
# Supabase Configuration (InsightPath Web Platform)
# ==============================================================================
# Browser-safe public credentials (Row Level Security protected)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Dedicated InsightPath FastAPI Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# WARNING: NEVER prefix SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_!
# Service role key must only ever exist on the backend / secure server contexts.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
