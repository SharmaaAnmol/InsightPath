# ==============================================================================
# InsightPath Frontend Production Environment Configuration (Vercel / Next.js)
# ==============================================================================

# Backend API Endpoint URL (Deployed FastAPI service on Render)
# Example: https://insightpath-backend.onrender.com
NEXT_PUBLIC_API_URL=https://insightpath-backend.onrender.com

# Supabase Authentication & Persistent Career Profiles
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# IMPORTANT: NEVER prefix SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_!
# Service-role keys must never be exposed to browser clients.
